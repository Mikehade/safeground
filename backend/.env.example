# SafeGround backend configuration
# Copy this to .env and fill in your values

# Postgres
PG_USERNAME=postgres
PG_PASSWORD=postgres
PG_HOSTNAME=localhost
PG_PORT=5432
PG_DB_NAME=safeground

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS Bedrock (required for Scout agent)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION_NAME=us-east-1

# OpenRouteService (free tier: https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=

# SerpAPI (https://serpapi.com — for web search tool)
SERP_API_KEY=

# Firecrawl (https://firecrawl.dev — for web scraping tool)
FIRECRAWL_API_KEY=

# Agent config
SCOUT_USE_GRAPH=false

# App
LOG_LEVEL=INFO
